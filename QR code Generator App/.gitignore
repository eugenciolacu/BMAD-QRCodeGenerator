# .gitignore for ASP.NET Core / C# projects
# Build results
bin/
obj/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio Code
.vscode/

# Logs
Logs/
*.log

# OS generated files
.DS_Store
Thumbs.db

# Publish output
publish/

# Others
wwwroot/lib/
node_modules/

# Rider
.idea/

# Backup files
*.bak
*.tmp

# Dotnet tools
*.pdb

# EF Migrations
Migrations/*Snapshot.cs
