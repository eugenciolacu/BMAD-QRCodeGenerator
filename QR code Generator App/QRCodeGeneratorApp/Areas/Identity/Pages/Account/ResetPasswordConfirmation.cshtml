@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password Reset Successful";
}

<div class="container d-flex flex-column align-items-center justify-content-center min-vh-100">
    <div class="w-100" style="max-width: 600px;">
        <div class="card shadow-sm p-4">
            <h2 class="mb-3 text-center">Password Reset Successful</h2>
            <div class="alert alert-success" role="alert">
                <p class="mb-0">Your password has been reset successfully. You can now log in with your new password.</p>
            </div>
            <div class="text-center mt-3">
                <a asp-page="./Login" class="btn btn-primary">Go to Login</a>
            </div>
        </div>
    </div>
</div>
