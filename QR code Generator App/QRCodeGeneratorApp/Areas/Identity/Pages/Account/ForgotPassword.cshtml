@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="container d-flex flex-column align-items-center justify-content-center min-vh-100">
    <div class="w-100" style="max-width: 600px;">
        <div class="card shadow-sm p-4">
            <h2 class="mb-3 text-center">Forgot your password?</h2>
            <p class="text-center text-muted mb-4">Enter your email address and we'll send you a link to reset your password.</p>
            <form method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control @(ViewData.ModelState["Input.Email"]?.Errors.Count > 0 ? "is-invalid" : "")" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email">Email</label>
                    <span asp-validation-for="Input.Email" class="invalid-feedback d-block"></span>
                </div>
                <button type="submit" class="w-100 btn btn-lg btn-primary mb-3">Send Reset Link</button>
                <div class="text-center">
                    <a asp-page="./Login" class="link-secondary">Back to Login</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
