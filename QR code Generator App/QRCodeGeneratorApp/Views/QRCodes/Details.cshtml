@model QRCodeGeneratorApp.Models.QRCodeDetailsViewModel
@{
    ViewData["Title"] = "QR Code Details";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

        <div class="card shadow-sm">
            <div class="card-header">
                <h4 class="mb-0">QR Code Details</h4>
            </div>
            <div class="card-body">

                <!-- QR Code Preview -->
                <div class="text-center mb-4">
                    @if (!string.IsNullOrEmpty(Model.PreviewDataUri))
                    {
                        <img src="@Model.PreviewDataUri"
                             alt="QR Code Preview"
                             class="img-fluid border rounded"
                             style="max-width: 240px;" />
                    }
                    else
                    {
                        <div class="alert alert-warning">Preview unavailable.</div>
                    }
                </div>

                <!-- Metadata Fields -->
                <dl class="row mb-0">
                    <dt class="col-sm-4">Content</dt>
                    <dd class="col-sm-8" style="word-break:break-word;white-space:pre-wrap">@Model.DecodedText</dd>

                    <dt class="col-sm-4">Error Correction</dt>
                    <dd class="col-sm-8">@Model.ErrorCorrectionLevel</dd>

                    <dt class="col-sm-4">QR Version</dt>
                    <dd class="col-sm-8">@Model.QRVersion</dd>

                    <dt class="col-sm-4">Created At (UTC)</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

                    <dt class="col-sm-4">Notes</dt>
                    <dd class="col-sm-8" style="word-break:break-word">
                        @(string.IsNullOrWhiteSpace(Model.Notes) ? "—" : Model.Notes)
                    </dd>
                </dl>
            </div>

            <div class="card-footer d-flex flex-wrap gap-2">
                <!-- Download PDF -->
                <a asp-controller="QRCodes"
                   asp-action="DownloadPdf"
                   asp-route-id="@Model.Id"
                   class="btn btn-success">Download PDF</a>

                <!-- Download Image — format selector (AC: 2) -->
                <div class="d-flex align-items-center gap-1">
                    <select id="img-format-select" class="form-select form-select-sm" style="width:auto" aria-label="Image format">
                        <option value="svg" selected>SVG</option>
                        <option value="png">PNG</option>
                    </select>
                    <a id="btn-download-image"
                       href="@Url.Action("DownloadImage", "QRCodes", new { id = Model.Id, format = "svg" })"
                       class="btn btn-outline-success"
                       onclick="updateImageDownloadHref(this)">Download Image</a>
                </div>

                <!-- Delete (Story 3.4) -->
                <form id="deleteForm" 
                      asp-controller="QRCodes"
                      asp-action="Delete"
                      asp-route-id="@Model.Id"
                      method="post"
                      style="display:inline">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteConfirmationModal">Delete</button>
                </form>

                <!-- Back link - Dynamic based on ReturnTo -->
                @if (Model.ReturnTo == "Create")
                {
                    <a asp-controller="QRCodes"
                       asp-action="Create"
                       class="btn btn-outline-secondary ms-auto">Back to Create QR Code</a>
                }
                else
                {
                    <a asp-controller="QRCodes"
                       asp-action="Index"
                       class="btn btn-outline-secondary ms-auto">Back to My QR Codes</a>
                }
            </div>
        </div>

    </div>
</div>

<!-- Delete Confirmation Modal (Story 5.5) -->
<div class="modal fade" id="deleteConfirmationModal" tabindex="-1" aria-labelledby="deleteConfirmationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger-subtle">
                <h5 class="modal-title" id="deleteConfirmationModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2"><strong>Are you sure you want to delete this QR code?</strong></p>
                <p class="text-muted mb-0">This action cannot be undone. The QR code will be permanently removed from your account.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Keep the download href in sync with the selected format
        function updateImageDownloadHref(anchor) {
            var format = document.getElementById('img-format-select').value;
            var baseUrl = '@Url.Action("DownloadImage", "QRCodes", new { id = Model.Id })';
            anchor.href = baseUrl + '?format=' + format;
            // Allow the default navigation to proceed (actual download)
        }

        // Also update href when the select changes (so keyboard / Enter works correctly)
        document.getElementById('img-format-select').addEventListener('change', function () {
            var btn = document.getElementById('btn-download-image');
            var format = this.value;
            var baseUrl = '@Url.Action("DownloadImage", "QRCodes", new { id = Model.Id })';
            btn.href = baseUrl + '?format=' + format;
        });

        // Handle delete confirmation modal (Story 5.5)
        document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
            document.getElementById('deleteForm').submit();
        });
    </script>
}
