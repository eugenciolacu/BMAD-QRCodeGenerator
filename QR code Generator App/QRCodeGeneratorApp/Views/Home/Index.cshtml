@{
    ViewData["Title"] = "Dashboard";
}

@if (User.Identity!.IsAuthenticated)
{
    <div class="row g-4 justify-content-center">
        <div class="col-12 col-sm-6 col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Create QR Code</h5>
                    <p class="card-text text-muted flex-grow-1">Generate a new QR code by entering a text string and selecting encoding parameters.</p>
                    <a asp-controller="QRCodes" asp-action="Create" class="btn btn-primary mt-2">+ Create QR Code</a>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">My QR Codes</h5>
                    <p class="card-text text-muted flex-grow-1">Browse, view and manage all QR codes you have created.</p>
                    <a asp-controller="QRCodes" asp-action="Index" class="btn btn-outline-primary mt-2">View My QR Codes</a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="text-center py-5">
        <h2 class="mb-3">Welcome to QR Code Generator</h2>
        <p class="text-muted">Sign in to start creating and managing your QR codes.</p>
    </div>
}